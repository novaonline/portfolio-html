{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "hostname",
    "allowedCidrs",
    "ingress",
    "runnerNamespace",
    "runnerLabels"
  ],
  "properties": {
    "image": {
      "type": "string",
      "pattern": "@sha256:[a-f0-9]{64}$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1
    },
    "allowedCidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[89]|[12][0-9]|3[0-2])|172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[2-9]|2[0-9]|3[0-2])|192\\.168\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[6-9]|2[0-9]|3[0-2])|100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[0-9]|2[0-9]|3[0-2])|[fF][cCdD][a-fA-F0-9:]+/(?:[7-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "clusterIssuer",
        "controllerNamespace",
        "controllerLabels",
        "natCidrs",
        "privateNetworkConfirmed"
      ],
      "additionalProperties": false,
      "properties": {
        "className": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "clusterIssuer": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "controllerNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "controllerLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "natCidrs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "type": "string",
                "pattern": "^(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[89]|[12][0-9]|3[0-2])|172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[2-9]|2[0-9]|3[0-2])|192\\.168\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[6-9]|2[0-9]|3[0-2])|100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[0-9]|2[0-9]|3[0-2])|[fF][cCdD][a-fA-F0-9:]+/(?:[7-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
              },
              {
                "pattern": "^[0-9.]+/32$"
              }
            ]
          }
        },
        "privateNetworkConfirmed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "natCidrs": {
                "minItems": 1
              }
            }
          },
          "then": {
            "properties": {
              "privateNetworkConfirmed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "runnerNamespace": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "runnerLabels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
