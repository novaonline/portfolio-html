    "test:browser": "playwright test",
    "test:helm": "node scripts/check-preview-chart.mjs"
  },
  "dependencies": {
    "astro": "^5.15.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/mdx": "^4.3.9",
    "@astrojs/rss": "^4.0.13",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.29.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": "24.x"
  }
