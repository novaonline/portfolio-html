{
  "name": "manny-portfolio-html",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "npm run content:check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "editorial": "node scripts/editorial/cli.mjs",
    "content:check": "node scripts/editorial/validate-public.mjs",
